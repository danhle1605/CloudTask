# ==============================================================================
# CloudTask - Mẫu Biến Môi Trường (.env.example)
# Đề tài số 8: Ứng dụng PaaS & Đánh giá gánh nặng vận hành
# ==============================================================================

# Cấu hình Flask
FLASK_ENV=development
APP_VERSION=v1.0.0
# Đổi thành chuỗi ngẫu nhiên dài tối thiểu 32 ký tự khi chạy Production
SECRET_KEY=dev-insecure-secret-key-32-chars-min-change-in-production

# Mã mời tham gia Workspace chung cho 3 thành viên
GROUP_INVITE_CODE=CLOUDTASK-GROUP-8

# Cookie Security (Bật true trên Render hoặc Linux VM có HTTPS)
SESSION_COOKIE_SECURE=false

# ------------------------------------------------------------------------------
# LỰA CHỌN 1: Chạy Database Local (Docker hoặc PostgreSQL máy cá nhân)
# ------------------------------------------------------------------------------
POSTGRES_USER=task_user
POSTGRES_PASSWORD=task_password
POSTGRES_DB=task_db
# Dành cho Flask chạy trên máy Host kết nối PostgreSQL local:
DATABASE_URL=postgresql+psycopg://task_user:task_password@localhost:5432/task_db
# Dành cho chạy pytest kiểm thử:
TEST_DATABASE_URL=postgresql+psycopg://task_user:task_password@localhost:5432/task_test_db

# ------------------------------------------------------------------------------
# LỰA CHỌN 2: Kết nối Neon PostgreSQL Cloud (Dành cho Render & Linux VM)
# Lấy từ Neon Dashboard -> Connection Details -> Connection string
# Nhớ thêm driver '+psycopg' vào URL (postgresql+psycopg://...)
# ------------------------------------------------------------------------------
# DATABASE_URL=postgresql+psycopg://neondb_owner:YOUR_PASSWORD@ep-sample-pooler.ap-southeast-1.aws.neon.tech/cloudtask-db?sslmode=require
