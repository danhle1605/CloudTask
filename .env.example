# ==============================================================================
# CloudTask — File mẫu cấu hình môi trường (.env.example)
# Đề tài số 8: Ứng dụng PaaS & Đánh giá gánh nặng vận hành
# ==============================================================================
FLASK_ENV=development
APP_VERSION=v1.0.0

# Khóa bí mật mã hóa Session & CSRF Protection (tối thiểu 32 ký tự)
SECRET_KEY=dev-insecure-secret-key-32-chars-min-change-in-production

# Mã mời định danh nhóm (dùng chung cho các thành viên vào cùng Workspace)
GROUP_INVITE_CODE=CLOUDTASK-GROUP-8

# Cookie Security: false ở localhost HTTP, true khi chạy HTTPS trên Render
SESSION_COOKIE_SECURE=false

# ------------------------------------------------------------------------------
# LỰA CHỌN 1: Chạy Database Local (Docker hoặc PostgreSQL máy cá nhân)
# ------------------------------------------------------------------------------
POSTGRES_USER=task_user
POSTGRES_PASSWORD=task_password
POSTGRES_DB=task_db
DATABASE_URL=postgresql+psycopg://task_user:task_password@localhost:5432/task_db
TEST_DATABASE_URL=postgresql+psycopg://task_user:task_password@localhost:5432/task_test_db

# ------------------------------------------------------------------------------
# LỰA CHỌN 2: Neon PostgreSQL Cloud (Dành cho Render & Linux VM)
# Lấy từ Neon Dashboard -> Connection Details -> Connection string
# Lưu ý: Không lưu mật khẩu thật vào file mẫu này.
# DATABASE_URL=postgresql+psycopg://neondb_owner:YOUR_PASSWORD@ep-sample-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
